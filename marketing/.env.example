# Supabase configuration for the marketing site and server route handlers

# Public Supabase URL (client-safe for future use)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Server-side Supabase URL for route handlers (defaults to NEXT_PUBLIC_SUPABASE_URL if unset)
SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (sb_publishable_) or service role key used by route handlers to invoke edge functions
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# SUPABASE_SERVICE_ROLE_KEY=ey...
